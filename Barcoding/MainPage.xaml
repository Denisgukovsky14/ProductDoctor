<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Barcoding.MainPage"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"  
             
             xmlns:viewmodel="clr-namespace:Barcoding.ViewModels"
             x:DataType="viewmodel:QRScannerViewModel"
             
             Shell.NavBarIsVisible="False"
             
             Title="Отсканируйте штрихкод"
             
             Shell.BackgroundColor="#00AD1C"
             Shell.TitleColor="Black"
             >



        <AbsoluteLayout >
        <zxing:CameraBarcodeReaderView
        
        x:Name="barcodeReader"
        BarcodesDetected="barcodeReader_BarcodesDetected"
            
        WidthRequest="400"
		HeightRequest="800"
            
        AbsoluteLayout.LayoutFlags="All"
        AbsoluteLayout.LayoutBounds="0, 0, 1, 1"/>

        <Grid  BackgroundColor="#00AD1C"
               AbsoluteLayout.LayoutFlags="All"
               AbsoluteLayout.LayoutBounds="0, 0, 1, 0.065"
               
               >
            <Image
                
                Margin="15,15,15,20"
                HorizontalOptions="End"
                HeightRequest="32"
                Source="scan.png">
            </Image>
        </Grid>
            
        <Image
            Source="scanning.png"
            HeightRequest="137"
            AbsoluteLayout.LayoutFlags="PositionProportional" 
            AbsoluteLayout.LayoutBounds="0.5, 0.4, AutoSize, AutoSize"
        />

        <Label
        x:Name="LabelCode"
        FontFamily="RobotoMed"
        AbsoluteLayout.LayoutFlags="PositionProportional" 
        AbsoluteLayout.LayoutBounds="0.5, 0.56, AutoSize, AutoSize"
        Text="Поднесите камеру к штрихкоду"
        TextColor="White"
        FontSize="16"/>

        <Grid
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds="0.5, 0.8, AutoSize, AutoSize">
            <Button
            HeightRequest="60"
            WidthRequest="230"
            Command="{Binding LoadNewsCommand }"
            FontFamily="RobotoBold"
            Text="Новости о товарах"
            FontSize="16"
            TextColor="White"
            BackgroundColor="#00AD1C"
            CornerRadius="25">
            
            </Button>
            <Ellipse Stroke="Black"
                     Margin="0,0,-8,-8"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     StrokeThickness="4"
                     BackgroundColor="White"
                     HeightRequest="27"
                     WidthRequest="27"/>
        </Grid>




    </AbsoluteLayout>
    

    <Page.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="#00AD1C"  StatusBarStyle="LightContent" x:Name="StatusBar" />
    </Page.Behaviors>

</ContentPage>
